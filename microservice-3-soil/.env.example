# Copy to .env and change the values before any shared or production use.
PORT=8091
PUBLIC_BASE_URL=http://localhost:8091
DB_PATH=data/soil.db
JWT_SECRET=change-me-to-a-long-random-string
DEV_MODE=true
SEED_DEMO=true
RUN_WORKER_IN_API=true
ADMIN_EMAIL=admin@soil.local
ADMIN_PASSWORD=Admin-Change-Me-2026
# Leave empty to use the built-in soil model. Set to the separate AI service when it is deployed.
SOIL_AI_URL=
SOIL_AI_SECRET=soil-ai-dev-secret
# Credentials other services use to call this one
AI_ANALYTICS_SECRET=ai-analytics-dev-secret
PLANT_HEALTH_SECRET=plant-health-dev-secret
# Services this one calls (JSON on one line). Empty until those services are deployed.
PEER_SERVICES={}
