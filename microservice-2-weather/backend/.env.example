ENVIRONMENT=development
LOCAL_DEV_AUTH_ENABLED=true
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
# Shared platform issuer/audience can be configured for integration later.
JWT_ISSUER=
JWT_AUDIENCE=
DATABASE_URL=sqlite:///./environment_weather.db
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local administrator login key. Change this before use.
ADMIN_ACCESS_KEY=Leafline-Admin-Local-Only-Change-Me
